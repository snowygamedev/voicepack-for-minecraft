{
  "name": "voicepack-for-minecraft",
  "version": "0.1.0",
  "description": "Create Minecraft resource packs from sounds you record yourself.",
  "license": "MIT",
  "author": "Snowy",
  "main": "./out/main/index.js",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snowygamedev/voicepack-for-minecraft.git"
  },
  "homepage": "https://github.com/snowygamedev/voicepack-for-minecraft#readme",
  "bugs": {
    "url": "https://github.com/snowygamedev/voicepack-for-minecraft/issues"
  },
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs dev",
    "start": "node scripts/dev.mjs preview",
    "build": "npm run typecheck && electron-vite build",
    "icon": "node scripts/make-icon.mjs",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack:dir": "npm run build && electron-builder --dir",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "ffmpeg-static": "^5.2.0",
    "yauzl": "^3.2.0",
    "yazl": "^3.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@eslint/js": "^9.8.0",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^2.4.5",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "electron": "^31.2.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "eslint": "^9.8.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "playwright-core": "^1.62.1",
    "postcss": "^8.4.39",
    "prettier": "^3.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.3.3",
    "vitest": "^2.0.3",
    "zustand": "^4.5.4"
  },
  "allowScripts": {
    "electron@31.7.7": true,
    "ffmpeg-static@5.3.0": true,
    "esbuild@0.21.5": true
  }
}
